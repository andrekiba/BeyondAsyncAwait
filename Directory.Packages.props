<Project>

  <ItemGroup>
    <!-- 0.15.x doesn't recognize .NET 11 ("GetRuntimeVersion not implemented for NotRecognized"). -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <!-- Ix 7: IObservable<T>.ToAsyncEnumerable() lives here (System.Linq.AsyncEnumerableEx). -->
    <PackageVersion Include="System.Interactive.Async" Version="7.0.1" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <!-- AsyncRx.NET: experimental, the only build on NuGet is this 2023 alpha (works with Rx 7). -->
    <PackageVersion Include="System.Reactive.Async" Version="6.0.0-alpha.18" />
  </ItemGroup>

</Project>
